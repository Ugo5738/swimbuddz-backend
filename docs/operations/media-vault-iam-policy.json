{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VaultBucketMultipartListing",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::REPLACE_PRIVATE_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["vaults/*", "vault-exports/*", "vault-derivatives/*"]
        }
      }
    },
    {
      "Sid": "VaultPrivateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_PRIVATE_BUCKET/vaults/*",
        "arn:aws:s3:::REPLACE_PRIVATE_BUCKET/vault-exports/*",
        "arn:aws:s3:::REPLACE_PRIVATE_BUCKET/vault-derivatives/*"
      ]
    },
    {
      "Sid": "PublishApprovedOriginals",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_PUBLIC_BUCKET/gallery/vaults/*"
    }
  ]
}
